// Novelku — Prisma Schema
// Database: PostgreSQL
// Semua model sesuai dengan desain database yang telah disetujui

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUM
// ============================================================

enum Role {
  USER
  ADMIN
}

enum NovelStatus {
  ONGOING
  COMPLETED
  HIATUS
}

// ============================================================
// USERS
// ============================================================

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  comments         Comment[]
  likes            Like[]
  ratings          Rating[]
  bookmarks        Bookmark[]
  readingHistories ReadingHistory[]
  readingSessions  ReadingSession[]

  @@map("users")
}

// ============================================================
// NOVELS
// ============================================================

model Novel {
  id            Int         @id @default(autoincrement())
  title         String      @db.VarChar(255)
  slug          String      @unique @db.VarChar(300)
  description   String?     @db.Text
  author        String      @db.VarChar(150)
  coverImage    String?     @map("cover_image") @db.VarChar(500)
  status        NovelStatus @default(ONGOING)
  totalChapters Int         @default(0) @map("total_chapters")
  viewCount     Int         @default(0) @map("view_count")
  averageRating Decimal     @default(0) @map("average_rating") @db.Decimal(3, 2)
  ratingCount   Int         @default(0) @map("rating_count")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  genres           NovelGenre[]
  chapters         Chapter[]
  comments         Comment[]
  likes            Like[]
  ratings          Rating[]
  bookmarks        Bookmark[]
  readingHistories ReadingHistory[]
  readingSessions  ReadingSession[]

  @@index([status])
  @@index([createdAt])
  @@map("novels")
}

// ============================================================
// GENRES
// ============================================================

model Genre {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  novels NovelGenre[]

  @@map("genres")
}

// ============================================================
// NOVEL_GENRES (Pivot / Junction Table)
// ============================================================

model NovelGenre {
  novelId Int @map("novel_id")
  genreId Int @map("genre_id")

  // Relations
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([novelId, genreId])
  @@index([genreId])
  @@map("novel_genres")
}

// ============================================================
// CHAPTERS
// ============================================================

model Chapter {
  id            Int      @id @default(autoincrement())
  novelId       Int      @map("novel_id")
  chapterNumber Int      @map("chapter_number")
  title         String   @db.VarChar(255)
  content       String   @db.Text
  wordCount     Int      @default(0) @map("word_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  novel            Novel            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  readingHistories ReadingHistory[]
  readingSessions  ReadingSession[]

  @@unique([novelId, chapterNumber])
  @@index([novelId])
  @@map("chapters")
}

// ============================================================
// COMMENTS
// ============================================================

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  novelId   Int      @map("novel_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
  @@index([userId])
  @@map("comments")
}

// ============================================================
// LIKES
// ============================================================

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  novelId   Int      @map("novel_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("likes")
}

// ============================================================
// RATINGS
// ============================================================

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  novelId   Int      @map("novel_id")
  value     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("ratings")
}

// ============================================================
// BOOKMARKS
// ============================================================

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  novelId   Int      @map("novel_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("bookmarks")
}

// ============================================================
// READING HISTORIES
// ============================================================

model ReadingHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  novelId    Int      @map("novel_id")
  chapterId  Int      @map("chapter_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, novelId])
  @@map("reading_histories")
}

// ============================================================
// READING SESSIONS (Analytics Pembaca Terautentikasi)
// ============================================================

model ReadingSession {
  id              Int       @id @default(autoincrement())
  sessionId       String    @unique @map("session_id") @db.VarChar(64)
  userId          Int       @map("user_id")
  novelId         Int       @map("novel_id")
  chapterId       Int       @map("chapter_id")
  startTime       DateTime  @default(now()) @map("start_time")
  lastHeartbeat   DateTime  @default(now()) @map("last_heartbeat")
  durationSeconds Int       @default(0) @map("duration_seconds")
  isCompleted     Boolean   @default(false) @map("is_completed")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([startTime])
  @@index([novelId, startTime])
  @@index([userId, startTime])
  @@map("reading_sessions")
}
